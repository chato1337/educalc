# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Incluye el hostname con el que el navegador llama al API (ej. api.tudominio.com), no solo el del front.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,localhost:5173

# Database engine: sqlite or postgresql
DB_ENGINE=postgresql

# PostgreSQL settings (used when DB_ENGINE=postgresql)
POSTGRES_DB=educalc
POSTGRES_USER=didiercuetia
POSTGRES_PASSWORD=1814
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLite setting (used when DB_ENGINE=sqlite)
SQLITE_PATH=db.sqlite3

# JWT (SimpleJWT)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Face-Auth SSO (hosted login + server-to-server token verify)
# El api_key NUNCA va en el frontend. redirect_uris en Face-Auth deben coincidir exactas:
#   http://localhost:5173/auth/callback
#   http://localhost:8443/auth/callback
# FACEAUTH_API=http://127.0.0.1:8001
# FACEAUTH_WEB=http://127.0.0.1:5174
# FACEAUTH_APP_ID=app_AbC123
# FACEAUTH_API_KEY=change-me
# FACEAUTH_TIMEOUT_SECONDS=10

# CORS (origen del front en el navegador: esquema + host + puerto si no es 443/80)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8443,http://127.0.0.1:8443

# HTTPS detrás de reverse proxy (nginx): recomendado en producción
# TRUST_X_FORWARDED_PROTO=true
# USE_X_FORWARDED_HOST=true
# Orígenes HTTPS para CSRF (admin, sesión); separados por coma, sin barra final
# CSRF_TRUSTED_ORIGINS=https://ineac.chatuzpark.store,https://api.chatuzpark.store