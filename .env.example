# =========================
# Docker Compose - eduCalc
# =========================
# Copia este archivo a ".env" en la raiz del proyecto:
# cp .env.example .env

# -------------------------
# Database service (db)
# -------------------------
DB_IMAGE=postgres:16-alpine
DB_CONTAINER_NAME=educalc_db
DB_PORT=5432
DB_HEALTHCHECK_INTERVAL=5s
DB_HEALTHCHECK_TIMEOUT=3s
DB_HEALTHCHECK_RETRIES=20

# Credenciales PostgreSQL (db y backend comparten estas variables)
POSTGRES_DB=educalc
POSTGRES_USER=educalc
POSTGRES_PASSWORD=educalc
POSTGRES_HOST=db
POSTGRES_PORT=5432

# -------------------------
# Backend service (Django)
# -------------------------
BACKEND_CONTAINER_NAME=educalc_backend
# Imagen etiquetada al hacer build (evita estados rotos si borraste capas con prune)
BACKEND_IMAGE=educalc-backend:dev
BACKEND_PORT=8000

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Incluye el hostname público del API (ej. api.tudominio.com) además del front y de "backend" en Docker.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DB_ENGINE=postgresql

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8443,http://127.0.0.1:8443

# Producción detrás de nginx/HTTPS (CORS preflight debe llegar a Django; ver README)
# TRUST_X_FORWARDED_PROTO=true
# USE_X_FORWARDED_HOST=true
# CSRF_TRUSTED_ORIGINS=https://tu-front.example.com,https://tu-api.example.com

# Face-Auth SSO (solo backend; el api_key no se expone al navegador)
# FACEAUTH_API=http://host.docker.internal:8001
# FACEAUTH_WEB=http://localhost:5174
# FACEAUTH_APP_ID=app_AbC123
# FACEAUTH_API_KEY=change-me
# FACEAUTH_TIMEOUT_SECONDS=10

# S3. AWS_S3_CUSTOM_DOMAIN es host público y endpoint del cliente. AWS_DEFAULT_ACL no se envía al subir.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=https://cdn.example.com

# -------------------------
# Frontend service (Vite)
# -------------------------
FRONTEND_CONTAINER_NAME=educalc_frontend
FRONTEND_IMAGE=educalc-frontend:dev
FRONTEND_PORT=5173
CHOKIDAR_USEPOLLING=true
# URL del API vista desde el navegador (puerto publicado del backend en el host)
VITE_API_BASE_URL=http://localhost:8000
# Opcional. Hosts extra para Vite (coma-separados). ineac.chatuzpark.store va por defecto en vite.config.ts
# VITE_ALLOWED_HOSTS=

# -------------------------
# Mobile service (Vite, app docente)
# -------------------------
MOBILE_CONTAINER_NAME=educalc_mobile
MOBILE_IMAGE=educalc-mobile:dev
MOBILE_PORT=8443
# Reutiliza VITE_API_BASE_URL y VITE_ALLOWED_HOSTS del bloque frontend
VITE_MOBILE_APP_NAME=INEAC — Docente
